#!/bin/bash
# Runs the suite before anything leaves the machine, so a broken build never reaches
# the deploy workflow. Takes about a minute.
#
# Enabled with:   git config core.hooksPath hooks
# Disabled with:  git config --unset core.hooksPath
# Bypassed once:  git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -x ./run-tests.sh ]; then
  echo "pre-push: run-tests.sh missing or not executable — skipping" >&2
  exit 0
fi

echo "pre-push: running the Grain Lab suite…"
if ./run-tests.sh > /tmp/grain-lab-prepush.log 2>&1; then
  tail -1 /tmp/grain-lab-prepush.log
  echo "pre-push: ok"
  exit 0
fi

echo "pre-push: TESTS FAILED — push aborted." >&2
grep -E '^(FAIL|THREW)' /tmp/grain-lab-prepush.log >&2 || tail -20 /tmp/grain-lab-prepush.log >&2
echo "pre-push: full log at /tmp/grain-lab-prepush.log (bypass with --no-verify)" >&2
exit 1
